# Non-secret settings of CARE on lumine. `just box-secrets-render`
# (lumine/render-secrets.sh) writes this plus the secrets from
# secrets/care-box.enc.env to /etc/care/care.env, which every care-* unit
# loads.
#
# Mirrors avocado's care-backend-env ConfigMap (k8s/care/care.yaml; its
# comments explain each value) with the care-box origin and without TeleICU.
# Only the differences are commented here.
#
# systemd EnvironmentFile syntax, NOT shell: single-quote anything containing
# double quotes (JSON), because systemd strips unquoted double quotes.

# = config.settings.deployment + EMAIL_USE_TLS from the env (care_box.py).
DJANGO_SETTINGS_MODULE=config.settings.care_box
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_ALLOWED_HOSTS='["*"]'
CORS_ALLOWED_ORIGINS='["https://care-box.rithviknishad.dev", "http://localhost:4000"]'
# One origin only: there is no separate API host like avocado's care-api.*.
CSRF_TRUSTED_ORIGINS='["https://care-box.rithviknishad.dev"]'
CURRENT_DOMAIN=https://care-box.rithviknishad.dev
BACKEND_DOMAIN=https://care-box.rithviknishad.dev

# Peer auth over the unix socket as the `care` OS user, so no password.
DATABASE_URL=postgres:///care
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Sized for 2 GB (lumine/PLAN.md "Memory budget"); read by the units.
GUNICORN_WORKERS=2
CELERY_WORKER_CONCURRENCY=1

BUCKET_PROVIDER=MINIO
BUCKET_REGION=ap-south-1
BUCKET_ENDPOINT=http://127.0.0.1:7070
BUCKET_EXTERNAL_ENDPOINT=https://care-box.rithviknishad.dev
FILE_UPLOAD_BUCKET=care-uploads
FACILITY_S3_BUCKET=care-facility

ABDM_GATEWAY_URL=https://dev.abdm.gov.in
ABDM_HSP_URL=https://apihspsbx.abdm.gov.in
ABDM_ABHA_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_CM_ID=sbx
# The sandbox has ONE bridge URL per client id and avocado holds it, so ABDM
# callbacks don't reach care-box until abdm_register_bridge_url runs here,
# which takes them away from avocado. Ask before doing that.
ABDM_CALLBACK_BASE_URL=https://care-box.rithviknishad.dev
ABDM_DEVELOPER_MODE=true

# avocado's Mailpit over the tailnet: AUTH required, plain SMTP (see
# docs/mailpit.md). The password is EMAIL_PASSWORD in the sops file.
EMAIL_HOST=avocado
EMAIL_PORT=1025
EMAIL_USER=csaas
EMAIL_USE_TLS=false
# Tells care-box mail apart in Mailpit's shared inbox.
EMAIL_FROM='CARE box <care-box@rithviknishad.dev>'
